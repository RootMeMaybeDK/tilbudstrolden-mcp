{
  "name": "tilbudstrolden-mcp",
  "version": "0.5.2",
  "type": "module",
  "description": "MCP server for Nordic grocery deal hunting (Denmark, Norway, Sweden, Finland). Search offers, score recipes against current deals, and generate optimized shopping lists.",
  "author": "Olga Safonova",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/olgasafonova/tilbudstrolden-mcp.git"
  },
  "homepage": "https://github.com/olgasafonova/tilbudstrolden-mcp",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "grocery",
    "deals",
    "tilbud",
    "danish",
    "etilbudsavis",
    "meal-planning",
    "shopping-list",
    "claude",
    "ai-tools"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "dist/server.js",
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:backend && npm run web:build",
    "build:backend": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "http:start": "node dist/http/server.js",
    "http:dev": "tsx watch src/http/server.ts",
    "lint": "biome check src/ web/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "typecheck": "tsc --noEmit && npm run web:typecheck",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "npm run web:typecheck && vite build --config web/vite.config.ts",
    "web:typecheck": "tsc -p web/tsconfig.json && tsc -p web/tsconfig.node.json",
    "web:test": "vitest run --config web/vitest.config.ts",
    "test": "vitest run",
    "test:all": "npm test && npm run web:test",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fs-ext": "2.1.1",
    "hono": "^4.13.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^4.3.6"
  },
  "overrides": {
    "path-to-regexp": "^8.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/fs-ext": "2.0.3",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.2"
  }
}
